[
  {
    "id": "L1-001",
    "level": 1,
    "text": "缓慢转动眼球，扫视房间内3件物品，单纯观察"
  },
  {
    "id": "L1-002",
    "level": 1,
    "text": "躺着聆听房间内原生背景音（风声、远处车流）"
  },
  {
    "id": "L1-003",
    "level": 1,
    "text": "凑近闻清水、洗衣液淡淡的气味，觉察气味本身"
  },
  {
    "id": "L1-004",
    "level": 1,
    "text": "静止放空5分钟，允许负面想法出现"
  },
  {
    "id": "L1-005",
    "level": 1,
    "text": "观察墙面光影变化，持续观察60秒"
  },
  {
    "id": "L1-006",
    "level": 1,
    "text": "在心里默念一句中性陈述：“我现在只是躺着，这就是当下的我”"
  },
  {
    "id": "L1-007",
    "level": 1,
    "text": "闭眼，感受床垫支撑背部的力量"
  },
  {
    "id": "L1-008",
    "level": 1,
    "text": "舔一下嘴唇，感受嘴唇湿润或者干燥的感觉"
  },
  {
    "id": "L1-009",
    "level": 1,
    "text": "数一数房间里能看到的圆形物品"
  },
  {
    "id": "L1-010",
    "level": 1,
    "text": "短暂闭上眼睛，感受眼皮的重量"
  },
  {
    "id": "L1-011",
    "level": 1,
    "text": "感受空气接触鼻尖的冷热"
  },
  {
    "id": "L1-012",
    "level": 1,
    "text": "在心里默默数自己的呼吸，数到10就重新开始"
  },
  {
    "id": "L1-013",
    "level": 1,
    "text": "观察房间阴影的轮廓，不去思考任何事情"
  },
  {
    "id": "L1-014",
    "level": 1,
    "text": "感受口腔内唾液的变化"
  },
  {
    "id": "L1-015",
    "level": 1,
    "text": "感受、觉察心跳"
  },
  {
    "id": "L1-016",
    "level": 1,
    "text": "觉察“我正在呼吸”"
  },
  {
    "id": "L1-017",
    "level": 1,
    "text": "小口分次喝水，专注感受水流划过喉咙的感觉"
  },
  {
    "id": "L1-018",
    "level": 1,
    "text": "触摸身边抱枕/被子，留意布料软硬、温度，觉察触感"
  },
  {
    "id": "L1-019",
    "level": 1,
    "text": "把手掌贴在床单上，感受床单纹路"
  },
  {
    "id": "L1-020",
    "level": 1,
    "text": "轻按揉自己的小臂，力度轻柔不疼痛"
  },
  {
    "id": "L1-021",
    "level": 1,
    "text": "轻轻叩击手心，感受震动"
  },
  {
    "id": "L1-022",
    "level": 1,
    "text": "有意识完成3次腹式呼吸，呼吸节奏完全跟随身体，不刻意加深"
  },
  {
    "id": "L1-023",
    "level": 1,
    "text": "逐个伸展、弯曲10根手指，感受指尖肌肉收缩的触感"
  },
  {
    "id": "L1-024",
    "level": 1,
    "text": "缓慢转动脚踝，顺时针、逆时针各2圈，幅度轻柔"
  },
  {
    "id": "L1-025",
    "level": 1,
    "text": "缓慢做小幅肩部耸肩-放松循环3次"
  },
  {
    "id": "L1-026",
    "level": 1,
    "text": "躺着，缓慢地抬头再放下，幅度极小"
  },
  {
    "id": "L1-027",
    "level": 1,
    "text": "轻轻活动下颌，缓慢张嘴、闭合"
  },
  {
    "id": "L1-028",
    "level": 1,
    "text": "调整睡姿，找到身体压力最小的支撑姿势"
  },
  {
    "id": "L1-029",
    "level": 1,
    "text": "在床上坐起保持30秒，一旦疲惫立刻躺下，不硬撑"
  },
  {
    "id": "L1-030",
    "level": 1,
    "text": "挪动身边1件小物件（一支笔、一块橡皮）"
  },
  {
    "id": "L1-031",
    "level": 1,
    "text": "更换一件上衣，感受衣物贴在皮肤上的变化"
  },
  {
    "id": "L1-032",
    "level": 1,
    "text": "手机黑屏静置2分钟，暂时脱离屏幕信息刺激"
  },
  {
    "id": "L1-033",
    "level": 1,
    "text": "挪动枕头，调整到让脖子更舒服的高度"
  },
  {
    "id": "L2-001",
    "level": 2,
    "text": "走到窗边站立，安静观察窗外景物，无需久站"
  },
  {
    "id": "L2-002",
    "level": 2,
    "text": "在纸上写下1个词语，记录当下身体感受"
  },
  {
    "id": "L2-003",
    "level": 2,
    "text": "观察家里绿植，看看叶片颜色、形态"
  },
  {
    "id": "L2-004",
    "level": 2,
    "text": "走到客厅，观察房间里灯光投射的影子"
  },
  {
    "id": "L2-005",
    "level": 2,
    "text": "在客厅静坐，觉察内心想法，不跟家人倾诉"
  },
  {
    "id": "L2-006",
    "level": 2,
    "text": "安静站在客厅，感受房间里空气温度"
  },
  {
    "id": "L2-007",
    "level": 2,
    "text": "拿一本书，只翻看其中一页，不用读完"
  },
  {
    "id": "L2-008",
    "level": 2,
    "text": "在阳台听听远处的环境声音"
  },
  {
    "id": "L2-009",
    "level": 2,
    "text": "坐在客厅，允许自己什么都不做，只是待在卧室以外的空间"
  },
  {
    "id": "L2-010",
    "level": 2,
    "text": "触摸家里墙面，感受墙面"
  },
  {
    "id": "L2-011",
    "level": 2,
    "text": "坐在家人旁边看书/看图片，互不交流"
  },
  {
    "id": "L2-012",
    "level": 2,
    "text": "关闭房间多余照明灯，调节环境降低感官过载"
  },
  {
    "id": "L2-013",
    "level": 2,
    "text": "尝一口常温食物，分辨酸甜咸其中一种味道"
  },
  {
    "id": "L2-014",
    "level": 2,
    "text": "站在厨房，安静看窗外片刻，不做饭"
  },
  {
    "id": "L2-015",
    "level": 2,
    "text": "自行走到厨房接一杯温水，独立完成取水动作"
  },
  {
    "id": "L2-016",
    "level": 2,
    "text": "和家人待在同一个房间，各自做自己的事，不开启对话"
  },
  {
    "id": "L2-017",
    "level": 2,
    "text": "拿一份清淡小零食，安静进食，专注品尝食物味道"
  },
  {
    "id": "L2-018",
    "level": 2,
    "text": "在客厅播放轻音乐，安静停留"
  },
  {
    "id": "L2-019",
    "level": 2,
    "text": "站在入户门内侧，向内观望，适应靠近家门边界的感受"
  },
  {
    "id": "L2-020",
    "level": 2,
    "text": "给自己倒一杯常温饮品，慢慢小口饮用"
  },
  {
    "id": "L2-021",
    "level": 2,
    "text": "拿起家里的小盆栽，看一看叶片，不挪动位置"
  },
  {
    "id": "L2-022",
    "level": 2,
    "text": "坐在沙发上，感受沙发支撑臀部的触感"
  },
  {
    "id": "L2-023",
    "level": 2,
    "text": "简单漱口，保持口腔清爽"
  },
  {
    "id": "L2-024",
    "level": 2,
    "text": "在阳台感受风吹到脸上的感觉"
  },
  {
    "id": "L2-025",
    "level": 2,
    "text": "简单擦拭水杯外壁，擦干净水渍"
  },
  {
    "id": "L2-026",
    "level": 2,
    "text": "轻轻拍打抱枕，整理抱枕形态"
  },
  {
    "id": "L2-027",
    "level": 2,
    "text": "整理自己的帽子/围巾，放到固定位置"
  },
  {
    "id": "L2-028",
    "level": 2,
    "text": "折叠一件自己的外套或T恤，完成小范围衣物整理"
  },
  {
    "id": "L2-029",
    "level": 2,
    "text": "和家人说一句客观事实短句（例：水凉了）"
  },
  {
    "id": "L2-030",
    "level": 2,
    "text": "打开水龙头洗手，感受水流流过手掌的触感"
  },
  {
    "id": "L2-031",
    "level": 2,
    "text": "擦拭桌面一小块污渍，只清理巴掌大小区域"
  },
  {
    "id": "L2-032",
    "level": 2,
    "text": "缓慢伸展躯干，舒展上半身，不追求大幅度拉伸"
  },
  {
    "id": "L2-033",
    "level": 2,
    "text": "整理自己的数据线，简单收拢放在一处"
  },
  {
    "id": "L2-034",
    "level": 2,
    "text": "将一件脏衣服放到洗衣篮，不立刻清洗"
  },
  {
    "id": "L2-035",
    "level": 2,
    "text": "把桌上散落的笔集中放到一个盒子里"
  },
  {
    "id": "L2-036",
    "level": 2,
    "text": "调整窗帘，拉开一部分，调节室内光线"
  },
  {
    "id": "L2-037",
    "level": 2,
    "text": "把桌上空水杯拿到水槽边"
  },
  {
    "id": "L2-038",
    "level": 2,
    "text": "在屋内缓慢步行一圈，留意脚掌踩在地板的触感"
  },
  {
    "id": "L2-039",
    "level": 2,
    "text": "走到阳台站立2分钟，感受室外温度和风"
  },
  {
    "id": "L2-040",
    "level": 2,
    "text": "整理床铺，简单铺平床单，不用叠得非常整齐"
  },
  {
    "id": "L2-041",
    "level": 2,
    "text": "将袋装垃圾放到家门口，暂时不下楼丢弃"
  },
  {
    "id": "L2-042",
    "level": 2,
    "text": "在屋内慢慢踱步，想停下就停下"
  },
  {
    "id": "L3-001",
    "level": 3,
    "text": "站在单元大门内侧，观察来往行人"
  },
  {
    "id": "L3-002",
    "level": 3,
    "text": "在户外觉察焦虑，心里标记：“我现在感到紧张”"
  },
  {
    "id": "L3-003",
    "level": 3,
    "text": "观察小区花草、流浪小猫小鸟，建立和外界的弱联结"
  },
  {
    "id": "L3-004",
    "level": 3,
    "text": "在小区里找一处树荫，安静站一会儿"
  },
  {
    "id": "L3-005",
    "level": 3,
    "text": "路过花坛，观察花朵形态，不停留很久"
  },
  {
    "id": "L3-006",
    "level": 3,
    "text": "在小区长椅坐着，观察天上云朵变化"
  },
  {
    "id": "L3-007",
    "level": 3,
    "text": "观察小区树木枝干，感受自然环境"
  },
  {
    "id": "L3-008",
    "level": 3,
    "text": "打开家门，站在门框位置2分钟，感受门外空气，随时可以退回屋内"
  },
  {
    "id": "L3-009",
    "level": 3,
    "text": "出门后，感受脚下路面触感（地砖、草地）"
  },
  {
    "id": "L3-010",
    "level": 3,
    "text": "在小区内缓慢行走，刻意留意3种不同的环境声音"
  },
  {
    "id": "L3-011",
    "level": 3,
    "text": "慢走途中，停下，感受风吹在脸上"
  },
  {
    "id": "L3-012",
    "level": 3,
    "text": "路过邻居，只点头示意，不开启交谈"
  },
  {
    "id": "L3-013",
    "level": 3,
    "text": "取外卖时，简单和配送员说一句“谢谢\""
  },
  {
    "id": "L3-014",
    "level": 3,
    "text": "下楼，踩一踩草坪边缘感受地面"
  },
  {
    "id": "L3-015",
    "level": 3,
    "text": "独自出门，走到离家最近的信箱位置"
  },
  {
    "id": "L3-016",
    "level": 3,
    "text": "在小区内慢走3-5分钟，路线自选，随时折返回家"
  },
  {
    "id": "L3-017",
    "level": 3,
    "text": "独自下楼，取一件小件包裹，拿到立刻回家"
  },
  {
    "id": "L3-018",
    "level": 3,
    "text": "在小区里面，换一条很短的新路走一走"
  },
  {
    "id": "L3-019",
    "level": 3,
    "text": "在便利店挑选一件最便宜的小物品，完成简单交易"
  },
  {
    "id": "L4-001",
    "level": 4,
    "text": "独自前往公园，在安静区域停留观察风景"
  },
  {
    "id": "L4-002",
    "level": 4,
    "text": "在街边安静行走，感受城市生活气息"
  },
  {
    "id": "L4-003",
    "level": 4,
    "text": "坐在公园长椅，安静放空10分钟"
  },
  {
    "id": "L4-004",
    "level": 4,
    "text": "观察路人的日常，恢复现实感，不做评判"
  },
  {
    "id": "L4-005",
    "level": 4,
    "text": "观看户外的云，观察云朵形态变化"
  },
  {
    "id": "L4-006",
    "level": 4,
    "text": "去博物馆/展览馆安静浏览，挑感兴趣的展品看"
  },
  {
    "id": "L4-007",
    "level": 4,
    "text": "在户外，练习接纳情绪波动，不因为情绪变差立刻逃跑"
  },
  {
    "id": "L4-008",
    "level": 4,
    "text": "外出归来，复盘这次外出的体验，只客观描述，不评判好坏"
  },
  {
    "id": "L4-009",
    "level": 4,
    "text": "提前简单规划一次外出，写下来想去的地点"
  },
  {
    "id": "L4-010",
    "level": 4,
    "text": "短暂逛书店/文具店，只看"
  },
  {
    "id": "L4-011",
    "level": 4,
    "text": "独自去花店，看看植物花卉"
  },
  {
    "id": "L4-012",
    "level": 4,
    "text": "沿着河边/湖边慢走，感受水体周边环境"
  },
  {
    "id": "L4-013",
    "level": 4,
    "text": "去文创小店浏览，单纯感受物品，不消费"
  },
  {
    "id": "L4-014",
    "level": 4,
    "text": "出门收集落叶、小石头，作为小纪念"
  },
  {
    "id": "L4-015",
    "level": 4,
    "text": "出门带笔记本，随手记下看到的有意思的细节"
  },
  {
    "id": "L4-016",
    "level": 4,
    "text": "和信任的朋友发送一条简短文字消息，分享当下感受"
  },
  {
    "id": "L4-017",
    "level": 4,
    "text": "独自乘坐1站短途公交，体验公共交通环境"
  },
  {
    "id": "L4-018",
    "level": 4,
    "text": "和店员进行简短自然问候，完成轻度社交"
  },
  {
    "id": "L4-019",
    "level": 4,
    "text": "外出购买自己想吃的清淡食物，自主挑选"
  },
  {
    "id": "L4-020",
    "level": 4,
    "text": "到图书馆安静坐一段时间，随意翻阅书籍"
  },
  {
    "id": "L4-021",
    "level": 4,
    "text": "独自去一家熟悉小店，固定点一份食物"
  },
  {
    "id": "L4-022",
    "level": 4,
    "text": "出门写生/随手画一张路边景物，不追求画得好看"
  },
  {
    "id": "L4-023",
    "level": 4,
    "text": "参加线上兴趣社群的一次低压力文字讨论"
  },
  {
    "id": "L4-024",
    "level": 4,
    "text": "独自去看一场白天的展览，不用全程看完"
  },
  {
    "id": "L4-025",
    "level": 4,
    "text": "短途慢骑行，在平缓的道路上，不追求速度"
  },
  {
    "id": "L4-026",
    "level": 4,
    "text": "和熟悉的朋友进行一次简短线上语音聊天"
  },
  {
    "id": "L4-027",
    "level": 4,
    "text": "和熟人在路上偶遇，可以简单打招呼交谈"
  },
  {
    "id": "L4-028",
    "level": 4,
    "text": "骑行前往附近的绿地，感受自然环境"
  },
  {
    "id": "L4-029",
    "level": 4,
    "text": "和朋友分享外出拍到的照片，简单交流"
  }
]